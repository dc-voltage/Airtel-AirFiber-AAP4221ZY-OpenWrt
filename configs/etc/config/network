
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '0004c899639a3dbd5c1d84c6ea980489e133'
	option ula_prefix 'fd4e:89d1:9a25::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.32.1'
	option ip6assign '60'
	option netmask '255.255.255.0'
	list dns '1.1.1.1'
	list dns '8.8.8.8'

config interface 'wan'
	option device 'wan'
	option proto 'dhcp'
	option peerdns '1'
	option metric '10'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'

config interface 'wwan'
	option proto 'dhcp'
	option mtu '1420'
	option auto '0'

config device 'phy1_sta0'
	option name 'phy1-sta0'
	option mtu '1420'

